<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".ItemViewActivity">

    <!-- Top Product Image with gradient overlay -->
    <FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="0dp"
        android:layout_height="340dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToOutline="true"
        android:background="@android:color/white"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/productImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Product Image"
            android:adjustViewBounds="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:backgroundTintMode="src_over"
            android:backgroundTint="#66000000" />
    </FrameLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/imageContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="18dp"
            android:background="@android:color/white"
            android:elevation="3dp"
            android:clipToOutline="true">

            <!-- Product Name -->
            <TextView
                android:id="@+id/nameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textSize="22sp"
                android:textColor="#1E1E1E"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Price -->
            <TextView
                android:id="@+id/priceTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="R 299.00"
                android:textSize="19sp"
                android:textColor="#2E7D32"
                android:fontFamily="sans-serif-medium" />

            <!-- Scent -->
            <TextView
                android:id="@+id/scentTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Floral Jasmine"
                android:visibility="invisible"
                android:textSize="15sp"
                android:textStyle="italic"
                android:textColor="#E91E63" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#E0E0E0" />

            <!-- Description -->
            <TextView
                android:id="@+id/descriptionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="This exquisite fragrance blends elegant notes of jasmine and sandalwood for a long-lasting, sophisticated scent."
                android:textSize="15sp"
                android:textColor="#4F4F4F"
                android:lineSpacingExtra="6dp"
                android:fontFamily="sans-serif" />

            <!-- Quantity label -->
            <TextView
                android:id="@+id/sizeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginLeft="130dp"
                android:text="Quantity"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <!-- Quantity controls -->
            <LinearLayout
                android:id="@+id/quantityLayout"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginLeft="100dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/minusButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="12dp"
                    android:background="#20E91E63"
                    android:backgroundTintMode="src_over"
                    android:clipToOutline="true"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="-"
                    android:textColor="#E91E63"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/quantityTextView"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#000000"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/plusButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="12dp"
                    android:background="#20E91E63"
                    android:backgroundTintMode="src_over"
                    android:clipToOutline="true"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#E91E63"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- Add to Cart Button -->
            <TextView
                android:id="@+id/learnMoreButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="Add to Cart"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:fontFamily="sans-serif-medium"
                android:backgroundTint="#E91E63"
                android:background="@android:color/holo_red_light"
                android:elevation="4dp"
                android:clipToOutline="true"
                android:letterSpacing="0.05" />

            <!-- Error -->
            <TextView
                android:id="@+id/errorTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Error loading product."
                android:textColor="#D32F2F"
                android:visibility="gone"
                android:layout_gravity="center_horizontal" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
