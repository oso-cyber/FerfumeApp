<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp"
    android:id="@+id/main"
   >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:animateLayoutChanges="true">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_marginEnd="170dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Go Back"
             />


        <!-- Header Image -->
        <ImageView
            android:layout_width="245dp"
            android:layout_height="149dp"
            android:layout_marginTop="20dp"
            android:contentDescription="Cake Icon"
            android:src="@drawable/img_48" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎂 Build Your Custom Cake"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose your perfect flavor, size, and design."
            android:textColor="#777"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Cake Size Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--Cake Size--"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginLeft="130dp"/>

                <Spinner
                    android:id="@+id/spinnerCakeSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/cake_sizes"
                    android:spinnerMode="dropdown"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Flavor Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--Flavor--"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginLeft="130dp"/>

                <Spinner
                    android:id="@+id/spinnerFlavor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/cake_flavors"
                    android:spinnerMode="dropdown"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Shape Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--Shape--"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginLeft="130dp"/>

                <RadioGroup
                    android:id="@+id/shapeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/radioRound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Round"/>

                    <RadioButton
                        android:id="@+id/radioSquare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Square"
                        android:layout_marginStart="20dp"/>

                    <RadioButton
                        android:id="@+id/radioHeart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Heart"
                        android:layout_marginStart="20dp"/>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Theme Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--Theme--"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginLeft="130dp"/>

                <Spinner
                    android:id="@+id/spinnerTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/cake_themes"
                    android:spinnerMode="dropdown"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Delivery Type Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery Type"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginLeft="130dp"/>

                <RadioGroup
                    android:id="@+id/deliveryGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/radioPickup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pickup"/>

                    <RadioButton
                        android:id="@+id/radioDelivery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivery"
                        android:layout_marginStart="20dp"/>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Special Requests Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Special Requests"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginLeft="130dp"/>

                <EditText
                    android:id="@+id/editTextSpecialRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Gluten-free, message on cake..."
                    android:background="@drawable/edittext_bg"
                    android:padding="12dp"
                    android:textColor="@color/black"
                    android:textColorHint="#888"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Place Order Button -->
        <Button
            android:id="@+id/btnPlaceOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Place Order 🎂"
            android:background="@drawable/rounded_button_pink"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:elevation="6dp"
            android:padding="14dp"/>
    </LinearLayout>
</ScrollView>
