<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0f0f0"
    android:padding="16dp"
    tools:context=".PrivacyPolicyActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#333333"
        android:padding="24dp">

        <!-- Back Button -->
        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#555555"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:textAllCaps="false"
            android:layout_marginBottom="16dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacy Policy"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Introduction -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="At Perfume App, we respect your privacy and are committed to protecting your personal data. This Privacy Policy explains how we collect, use, and safeguard your information when you use our services."
            android:textSize="14sp"
            android:textColor="#DDDDDD"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Information Collection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Information We Collect"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We may collect personal information such as your name, email address, delivery address, and payment details when you use our app or make purchases."
            android:textSize="14sp"
            android:textColor="#DDDDDD"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Use of Information -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. How We Use Your Information"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your data helps us process orders, improve our services, and provide a better user experience. We may also use it to contact you for customer support or promotional updates."
            android:textSize="14sp"
            android:textColor="#DDDDDD"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Data Protection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Data Protection and Security"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We use industry-standard security measures to protect your information from unauthorized access, alteration, or disclosure. However, no system is completely secure, and we cannot guarantee absolute security."
            android:textSize="14sp"
            android:textColor="#DDDDDD"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Sharing Policy -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. Sharing of Information"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We do not sell or rent your personal data. We may share limited information with trusted partners to facilitate payments, deliveries, or legal obligations."
            android:textSize="14sp"
            android:textColor="#DDDDDD"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="12dp" />

        <!-- User Rights -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5. Your Rights"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You have the right to access, update, or delete your personal data. You may contact us at any time to exercise these rights."
            android:textSize="14sp"
            android:textColor="#DDDDDD"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Contact Section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#555555"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Us"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="If you have any questions about this Privacy Policy, please contact us at:"
            android:textSize="14sp"
            android:textColor="#DDDDDD"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="support@perfumeapp.com"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:layout_gravity="center_horizontal" />

    </LinearLayout>

</ScrollView>
